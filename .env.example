# Rasadbin bootstrap configuration.
# Real environment variables override this file; CLI flags override both.

HTTP_HOST=127.0.0.1
HTTP_PORT=9090
DATA_DIR=./data
WEBUI_DIR=webui/dist

# Password for the initial admin user. If unset, a random one is printed to stderr.
ADMIN_PASSWORD=replace-with-a-strong-password

# Linux interface for packet capture (requires CAP_NET_RAW). Leave empty
# to use the collector default.
CAPTURE_INTERFACE=eth0

# Maximum OS threads/goroutines used by the runtime (0 = NumCPU).
MAX_GOROUTINES=8

# Comma-separated syslog files to tail (missing files are ignored until they appear).
SYSLOG_PATHS=/var/log/auth.log,/var/log/syslog,/var/log/messages,/var/log/secure

# Comma-separated service log files to tail (nginx/Apache access, nginx error, or any text log).
SERVICE_LOG_PATHS=/var/log/nginx/access.log,/var/log/nginx/error.log
# ── Database 
# Driver: sqlite (default) | postgres | mysql
DB_DRIVER=sqlite
# SQLite: path to the database file (relative to DATA_DIR or absolute)
DB_DSN=./data/rasadbin.db
# Postgres/MySQL example DSNs:
#   DB_DSN=host=127.0.0.1 user=rasadbin password=secret dbname=rasadbin port=5432 sslmode=disable
#   DB_DSN=rasadbin:secret@tcp(127.0.0.1:3306)/rasadbin?charset=utf8mb4&parseTime=True
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=1h
DB_LOG_LEVEL=warn        # silent | error | warn | info